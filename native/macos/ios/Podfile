# Use the CDN to make CircleCI builds faster.
source 'https://cdn.cocoapods.org/'

platform :ios, '15.0'

target 'FontScreenshotter' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for FontScreenshotter
  pod 'Haneke', '~> 1.0.2', :inhibit_warnings => true
  pod 'Reachability', '~> 3.2'

  target 'FontScreenshotterUITests' do
    # Pods for testing
  end

end

target 'Tsurukame' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for Tsurukame
  pod 'FMDB', '~> 2.7.5'
  pod 'Haneke', '~> 1.0.2', :inhibit_warnings => true
  pod 'MMDrawerController', '~> 0.6.0', :inhibit_warnings => true
  pod 'Reachability', '~> 3.2'
  pod 'SwiftGen', '~> 6.0'

  target 'Tests' do
    inherit! :search_paths

    platform :ios, '15.0'
    pod 'Hippolyte', '~> 1.3.0'
  end
end

# Keep dependencies on the same supported deployment target as the app.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end
